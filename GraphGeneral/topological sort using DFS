class Solution {
    public ArrayList<Integer> topoSort(int V, int[][] edges) {
        //afjacency 
        ArrayList<ArrayList<Integer>> adj= new ArrayList<>();
        for(int i=0; i<V; i++){
            adj.add(new ArrayList<>());
        }
        for(int edge[]: edges){
            adj.get(edge[0]).add(edge[1]);
        }
        
        Stack<Integer> stk= new Stack<>();
        boolean visited[]= new boolean[V];
        for(int i=0; i<V; i++){
            if(!visited[i]) DFS(i, adj, visited, stk);
        }
        ArrayList<Integer> ans= new ArrayList<>();
        while(!stk.isEmpty()){
            ans.add(stk.pop());
        }
        return ans;
    }
    public void DFS(int u, ArrayList<ArrayList<Integer>> adj, boolean[] visited, Stack<Integer> stk){
        visited[u]=true;
        for( int v : adj.get(u)){
            if(!visited[v]) DFS(v, adj, visited, stk);
        }
        stk.push(u);
    }
}
