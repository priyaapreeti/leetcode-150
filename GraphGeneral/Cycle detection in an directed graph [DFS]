class Solution {
    public boolean isCyclic(int V, int[][] edges) {
        // build adjacency
        ArrayList<ArrayList<Integer>> adj= new ArrayList<>();
        for(int i=0; i<V; i++){
            adj.add(new ArrayList<>());
        }
        for(int edge[]: edges){
            adj.get(edge[0]).add(edge[1]);
        }
        boolean[] visited= new boolean[V];
        boolean[] recStack=new boolean[V];
        
        for(int i=0; i<V; i++){
            if(!visited[i] && dfs(adj, i, visited, recStack)) return true;
        }
        return false;
    }
    public boolean dfs(ArrayList<ArrayList<Integer>> adj, int u, boolean[] visited, boolean[] recStack){
        if(recStack[u]) return true; //cycle exists
        if(visited[u]) return false; //just visited
        
        recStack[u]=true;
        visited[u]=true;
        
        for(int v:adj.get(u)){
            if(dfs(adj, v, visited, recStack)) return true;
        }
        recStack[u]=false;
        return false;
        
    }
}
